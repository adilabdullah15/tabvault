{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "TabVault"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "description": "Open TabVault",
      "suggested_key": {
        "default": "Alt+Shift+V"
      }
    },
    "save-snapshot": {
      "description": "Save a snapshot of the current window now",
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    }
  },
  "description": "Never lose a tab again. TabVault auto-saves your windows, organizes tabs into workspaces, and restores everything in one click.",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "TabVault — Auto-Save Tab Manager",
  "options_page": "options.html",
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "version": "1.1.0"
}